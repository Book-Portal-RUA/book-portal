ruaportal.duckdns.org {
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
    }
    reverse_proxy app:3000 {
        # Matches the app's own `maxDuration = 300` on the upload route
        # (src/app/api/books/route.ts) - a large PDF on slow campus wifi can
        # legitimately take a while to arrive; nothing here should time it
        # out before the app itself would.
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }
}


# Cloudflare Tunnel origin. No `tls` block on purpose: Cloudflare's edge
# terminates the public HTTPS side of this hostname, so Caddy only ever
# sees plain HTTP from cloudflared over localhost. The explicit http://
# scheme is what tells Caddy not to attempt ACME here — without it Caddy
# would try (and fail) to get a Let's Encrypt cert for a hostname whose
# public DNS doesn't point at this box at all.
http://ruaportal.dpdns.org {
    reverse_proxy app:3000 {
        header_up X-Forwarded-Proto https
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }
}